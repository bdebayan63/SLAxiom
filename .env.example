# ==============================================================================
# SLAxiom — Environment Configuration Template
# ==============================================================================

# Target Midnight Network: "preview" | "preprod"
VITE_NETWORK=preprod

# Public RPC Endpoints
VITE_RPC_URL_PREVIEW=https://rpc.preview.midnight.network
VITE_RPC_URL_PREPROD=https://rpc.preprod.midnight.network

# Public GraphQL Indexer Endpoints
VITE_INDEXER_URL_PREVIEW=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_URL_PREPROD=https://indexer.preprod.midnight.network/api/v4/graphql

# Block Explorer Base URLs (Note: Explorer endpoints use plural /contracts/ and /transactions/)
VITE_EXPLORER_URL_PREVIEW=https://preview.midnightexplorer.com
VITE_EXPLORER_URL_PREPROD=https://preprod.midnightexplorer.com

# Faucet Links
VITE_FAUCET_URL_PREVIEW=https://midnight-tmnight-preview.nethermind.dev/
VITE_FAUCET_URL_PREPROD=https://midnight-tmnight-preprod.nethermind.dev/

# Deployed Contract Addresses (64-character lowercase hex without 0x prefix)
VITE_CONTRACT_ADDRESS_PREVIEW=fc67e2850565814578b9071c8901ad98236746ef9200b201cdba8418ff01ae2b
VITE_CONTRACT_ADDRESS_PREPROD=a41d08e923bb64c78119ce928e1005ab86378e9124a919cdba8199201ff62a4b

# Local Proof Server Endpoint
VITE_PROOF_SERVER_URL=http://localhost:6300

# Application Metadata & Links
VITE_APP_TITLE=SLAxiom
VITE_APP_DESCRIPTION=Confidential Contract Performance & SLA Verification on Midnight Network
VITE_FEEDBACK_FORM_URL=https://forms.gle/SLAxiomFeedback2026
VITE_PRODUCT_X_PROFILE=https://x.com/SLAxiomPrivacy
